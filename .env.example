# Copy this to `.env` ON THE SERVER and fill in real values. NEVER commit the real .env.
#   cp .env.example .env  &&  nano .env

# Claude writes the creative Image + A+ plans (required for AI; without it the app
# falls back to template copy). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Team password that gates the hosted URL (choose a strong one, share with the team).
APP_PASSWORD=change-me-to-a-strong-password

# The domain the tool is served on (must point to this server via a DNS A-record).
APP_DOMAIN=plans.equalice-academy.com

# Optional: real moodboard reference images. https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=

# Build context = repo root. Keep the image lean, but DO ship the brand knowledge
# (brand_study.md + each product's SOURCE_NOTES.md + run.py) so Brand Memory works.

# virtualenvs / caches / vcs
.venv/
**/__pycache__/
**/*.pyc
.git/
**/.DS_Store

# disposable + huge sync artifacts
.tmp/
".tmp 2/"
.tmp*/

# heavy binaries not needed at runtime
*.zip
*.ai
*.psd
*.eps
**/*.pdf
**/*.xlsx
**/*.xls

# raw client source + design assets (big; not needed by the app)
tools/brief_app/customers/*/source/
tools/brief_app/customers/*/products/*/assets/
tools/brief_app/customers/*/products/*/legacy/
tools/brief_app/customers/*/legacy/

# NEVER bake secrets into the image
.env
.env.*
credentials.json
token.json
